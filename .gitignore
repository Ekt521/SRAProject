# ===== 安全：环境变量（含 API 密钥，严禁提交）=====
.env
.env.local
.env.*.local

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== 本地模型（体积大，由 requirements + 首次运行自动下载）=====
models/

# ===== 运行时数据（记忆数据库、测试库等）=====
storage/

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# ===== 本地工具设置（保留可共享的项目配置）=====
.claude/settings.local.json

# ===== 本地压缩包 / 整仓备份 =====
/*.zip

# ===== 测试、构建与缓存 =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.log
logs/

